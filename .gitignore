# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
# `supabase functions serve` reads this one; it is NOT covered by .env*.local
supabase/functions/.env
# Anything ending .env, wherever it sits: `.env`, and the `one.env` / `two.env`
# shape that sat untracked in the repo root for weeks. Named as a pattern
# rather than as those two files, because the next one will be called
# something else and a `git add -A` does not ask.
*.env

# vercel
.vercel

# BMAD Method - track _bmad/ (has our customizations), ignore output
_bmad-output/

# typescript
*.tsbuildinfo
next-env.d.ts

# local artifacts
.npm-cache/
logs/
design-system/
{output_folder}/
test-coach.mjs

# Migrated Antigravity session history (kept local, not tracked)
docs/history/
